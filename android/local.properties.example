# Copy to android/local.properties (gitignored) and fill in paths + keys.
sdk.dir=/path/to/Android/sdk
flutter.sdk=/path/to/flutter

# Required for Google Map tiles on Android (Maps SDK for Android enabled in GCP).
# Often the same key as Firebase Android, restricted by package + SHA-1.
google.maps.apiKey=YOUR_ANDROID_MAPS_API_KEY
